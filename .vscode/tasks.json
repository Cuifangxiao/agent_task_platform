{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api",
      "type": "shell",
      "command": "go",
      "args": ["run", "./apps/api/cmd/server", "--conf", "apps/api/config/config.yaml"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "runtime",
      "type": "shell",
      "command": "${workspaceFolder}/apps/runtime/.venv/Scripts/python.exe",
      "args": ["main.py", "--conf", "config.yaml"],
      "options": {
        "cwd": "${workspaceFolder}/apps/runtime"
      },
      "problemMatcher": []
    },
    {
      "label": "web",
      "type": "npm",
      "script": "dev",
      "path": "apps/web/",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "all",
      "dependsOrder": "parallel",
      "dependsOn": ["api", "runtime", "web"],
      "problemMatcher": []
    }
  ]
}
