{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "api",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/api/cmd/server",
      "args": ["--conf", "${workspaceFolder}/apps/api/config/config.yaml"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "runtime",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/runtime/main.py",
      "args": ["--conf", "config.yaml"],
      "cwd": "${workspaceFolder}/apps/runtime",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/apps/runtime/.venv/Scripts/python.exe",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/runtime:${workspaceFolder}"
      } 
    },
    {
      "name": "web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/apps/web"
    }
  ],
  "compounds": [
    {
      "name": "all",
      "configurations": ["api", "runtime", "web"],
      "stopAll": true
    },
    {
      "name": "backend",
      "configurations": ["api", "runtime"],
      "stopAll": true
    }
  ]
}
