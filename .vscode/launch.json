{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "go-server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "args": ["--conf", "${workspaceFolder}/configs/config.yaml"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "python-agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/python-agent/main.py",
      "args": ["--conf", "config.yaml"],
      "cwd": "${workspaceFolder}/python-agent",
      "console": "integratedTerminal",
      "justMyCode": false,
      "python": "${workspaceFolder}/python-agent/.venv/bin/python",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/python-agent:${workspaceFolder}"
      }
    },
    {
      "name": "front",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/front"
    }
  ],
  "compounds": [
    {
      "name": "all",
      "configurations": ["go-server", "python-agent", "front"],
      "stopAll": true
    },
    {
      "name": "server",
      "configurations": ["go-server", "python-agent"],
      "stopAll": true
    }
  ]
}
