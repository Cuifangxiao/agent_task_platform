<section class="slide">
  <header class="slide-header"><h1 class="title" data-text>{{ title }}</h1></header>
  <main class="metric-grid">
    {% for card in content.cards %}
    <article class="panel metric-card">
      <div class="metric-value" data-text>{{ card.value }}</div>
      <strong data-text>{{ card.label }}</strong>
      <p class="caption" data-text>{{ card.caption }}</p>
    </article>
    {% endfor %}
  </main>
  <div class="footer-number">{{ index }}</div>
</section>
