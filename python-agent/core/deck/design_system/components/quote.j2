<section class="slide">
  <header class="slide-header"><h1 class="title" data-text>{{ title }}</h1></header>
  <blockquote class="panel quote-block">
    <p class="quote-text" data-text>{{ content.quote }}</p>
    <p class="caption" data-text>{{ content.speaker }}</p>
  </blockquote>
  <div class="footer-number">{{ index }}</div>
</section>
