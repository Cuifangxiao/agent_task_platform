<section class="slide cover">
  <div class="cover-mark" aria-hidden="true"></div>
  <div class="eyebrow cover-eyebrow" data-text>{{ content.eyebrow }}</div>
  <h1 class="title cover-title" data-text>{{ title }}</h1>
  <p class="subtitle cover-subtitle" data-text>{{ content.subtitle }}</p>
  <div class="motif-line"></div>
  <div class="footer-number">{{ index }}</div>
</section>
